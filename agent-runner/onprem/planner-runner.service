[Unit]
Description=Planner on-premises agent supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=planner-runner
Group=planner-runner
WorkingDirectory=/opt/planner
EnvironmentFile=/etc/planner-runner/runner.env
ExecStart=/usr/bin/env npm --prefix /opt/planner/agent-runner run supervisor
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/planner-runner

[Install]
WantedBy=multi-user.target
