# Non-secret settings for one on-premises runner host.
PLANNER_BASE_URL=https://planner.example.com
# Set this only when containers need a different route to Planner.
# PLANNER_CONTAINER_BASE_URL=http://host.containers.internal:3000
SCM_PROVIDER=bitbucket_data_center
BITBUCKET_BASE_URL=https://bitbucket.example.com

LLM_MODEL=openai/kimi-k2.6
LLM_API_BASE=https://opencode.ai/zen/go/v1

# Start with two slots. Increase this only after CPU and memory measurements.
MAX_PARALLEL=2
AGENT_CPUS=2
AGENT_MEMORY=6g
SUPERVISOR_POLL_INTERVAL_MS=3000
SUPERVISOR_MERGE_CHECK_INTERVAL_MS=15000

# Use docker or podman. Use a rootless runtime on the enterprise host.
CONTAINER_RUNTIME=docker
RUNNER_IMAGE=planner-agent-runner:local
OPENHANDS_IMAGE=planner-openhands-agent-server:local

RUNNER_REPOSITORY_CACHE=/var/lib/planner-runner/mirrors
ONPREM_SECRET_DIR=/etc/planner-runner/secrets
