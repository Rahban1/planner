FROM node:24.21.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci
COPY src ./src
RUN npm run build

FROM node:24.21.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY package.json ./package.json
COPY internal-entrypoint.sh /usr/local/bin/planner-agent-entrypoint
RUN chmod 755 /usr/local/bin/planner-agent-entrypoint && mkdir -p /workspace/runs && chown -R node:node /workspace
USER 1000:1000
ENV NODE_ENV=production RUNNER_WORKSPACE=/workspace/runs SCM_PROVIDER=bitbucket_data_center
ENTRYPOINT ["/usr/local/bin/planner-agent-entrypoint"]
CMD ["node", "dist/index.js"]
