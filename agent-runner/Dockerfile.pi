FROM mcr.microsoft.com/playwright/python:v1.50.0-noble
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git gh ripgrep time ffmpeg xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node:22.19.0-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22.19.0-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && npm install --global pnpm@10.32.1 \
    && python -m pip install --no-cache-dir playwright==1.50.0

COPY package.json package-lock.json tsconfig.json ./
RUN npm ci
COPY src ./src
RUN npm run build

ENV AGENT_ENGINE=pi
ENV NODE_ENV=production
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
CMD ["node", "dist/index.js"]
