{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "planner",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"main": "@tanstack/react-start/server-entry",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "planner",
			"database_id": "cb5ce300-f9ce-4b44-9bb2-5f856fd05927",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "planner-attachments"
		},
		{
			"bucket_name": "planner-attachments",
			"binding": "planner_attachments",
			"remote": true
		}
	]
}