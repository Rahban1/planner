# Set the public HTTPS origin. Do not add a final slash.
APP_ORIGIN=https://planner.example.internal
AUTH_MODE=oauth2_proxy
PLANNER_DATA_DIR=/data
SCM_PROVIDER=bitbucket_data_center
BITBUCKET_BASE_URL=https://bitbucket.example.internal
PLANNER_BASE_URL=http://planner:3000
OPENHANDS_BASE_URL=http://127.0.0.1:8000
RUNNER_WORKSPACE=/workspace/runs
# Use your approved model and API gateway.
LLM_MODEL=anthropic/claude-sonnet-4-5
LLM_API_BASE=https://llm-gateway.example.internal
