# Generate RUNNER_API_TOKEN with: openssl rand -hex 32
RUNNER_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Bitbucket user token with repository write and pull-request access.
SCM_TOKEN=REPLACE_WITH_BITBUCKET_RUNNER_TOKEN
# Separate Bitbucket token with repository read access for the app review panel.
BITBUCKET_READ_TOKEN=REPLACE_WITH_BITBUCKET_READ_TOKEN
LLM_API_KEY=REPLACE_WITH_APPROVED_MODEL_KEY
