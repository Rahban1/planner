# Claude API key (required for the agent runner)
ANTHROPIC_API_KEY=sk-ant-...

# Direct Anthropic API. Keep the anthropic/ provider prefix.
LLM_MODEL=anthropic/claude-sonnet-5
LLM_API_BASE=https://api.anthropic.com

# Bitbucket Data Center configuration
# SCM_TOKEN: Personal access token with repository read/write access (used by the runner)
# BITBUCKET_BASE_URL: Root URL of your Bitbucket server (e.g. https://bitbucket.example.com)
# BITBUCKET_READ_TOKEN: Personal access token with read-only access (used by the planner server)
SCM_TOKEN=BBDC-MDE5OTY1MDYzNTY0OuHMLYZPUgssNmvi4pD8+byr482U
BITBUCKET_BASE_URL=https://bitbucket.itg.ti.com
BITBUCKET_READ_TOKEN=BBDC-MDE5OTY1MDYzNTY0OuHMLYZPUgssNmvi4pD8+byr482U

# Shared secret for requests from the agent runner to /api/runner/*.
# Store the same value in both the deployed server and the runner environment.
RUNNER_API_TOKEN=...

# URL the runner uses to reach the planner dev server.
# Docker Desktop Mac users: if host.docker.internal does not route to localhost,
# use the host's LAN IP (e.g. http://192.168.1.22:3000) instead.
PLANNER_BASE_URL=http://host.docker.internal:3000

# SSO configuration for local development.
# In production (Kubernetes + oauth2-proxy), x-forwarded-email is injected automatically.
# For local dev, set your TI aID here; it will be used to derive a fake email.
# These go in .env.local (gitignored via *.local).
VITE_DEV_SSO_USER=a1257245
