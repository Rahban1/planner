# Anthropic API key (required for the agent runner)
LLM_API_KEY=sk-...

# OpenHands uses the LiteLLM provider/model format.
LLM_MODEL=anthropic/claude-sonnet-5
# Keep this empty for the direct Anthropic API. Set it only for an approved
# enterprise model gateway.
LLM_API_BASE=

# GitHub personal access token for the agent to push branches and create PRs
GITHUB_TOKEN=ghp_...

# Token used by the deployed Worker to start planner-agent-run.yml.
# Give this token Actions write access only to Rahban1/planner, then store it
# with: pnpm wrangler secret put GITHUB_ACTIONS_DISPATCH_TOKEN
GITHUB_ACTIONS_DISPATCH_TOKEN=github_pat_...

# Shared secret for requests from GitHub Actions to /api/runner/*.
# Store the same value in the Worker and the planner-runner GitHub environment.
RUNNER_API_TOKEN=...

# URL the runner uses to reach the planner dev server.
# Docker Desktop Mac users: if host.docker.internal does not route to localhost,
# use the host's LAN IP (e.g. http://192.168.1.22:3000) instead.
PLANNER_BASE_URL=http://host.docker.internal:3000

# OAuth apps used by Planner's in-app sign-in.
# Create separate local and production OAuth apps. Register these callback URLs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/github
#   https://planner.rahban-ghani2001.workers.dev/api/auth/callback/google
#   https://planner.rahban-ghani2001.workers.dev/api/auth/callback/github
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
